# Copia este archivo a .streamlit/secrets.toml (en tu PC) o pega su contenido
# en Streamlit Cloud → tu app → Settings → Secrets.
# NO lo subas a GitHub con datos reales.

[sheets]
# Lo que va entre /d/ y /edit en la URL del Google Sheet
spreadsheet_id = "PEGA_AQUI_EL_ID_DEL_SHEET"

[gcp_service_account]
# Copia cada campo del archivo .json que descargaste de Google Cloud
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "algo@tu-proyecto.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
